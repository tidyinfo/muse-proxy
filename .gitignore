# --- build output ---
/bin/
# goreleaser's output directory. Anchored: a bare "dist/" would also swallow
# any legitimately named dist/ subdirectory. This one was missed once and
# shipped 19 build artifacts to a public repo.
/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.out
coverage.html

# --- secrets and local config ---
# Real secret files never belong here. *.example files are the tracked
# templates, so the negation below is load-bearing, not decoration.
*.env
.env
.env.*
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
*.asc
*.gpg
id_rsa*
id_ed25519*
*secret*
# ...but keep the templates that ship with the repo:
!*.env.example
!*.example

# --- runtime artifacts ---
*.log
*.pid
*.sock
logs/

# --- editors / OS ---
.DS_Store
.idea/
.vscode/
*.swp
*~
\#*\#
.\#*
