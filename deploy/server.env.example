# Copy to server.env next to docker-compose.yml, then edit:
#     cp deploy/server.env.example server.env && chmod 600 server.env
# server.env is gitignored. Never commit the real file.
#
# The server reads this with -secret-file, which accepts either a bare token
# or a FWD_SECRET= line. Generate one with: openssl rand -hex 32

FWD_SECRET=PASTE_GENERATED_SECRET_HERE

# Sent to the client in every OPEN frame; it is where the client forwards
# streams to. Override per-deployment without editing this file:
#     TARGET=127.0.0.1:2222 docker compose up -d
#TARGET=127.0.0.1:22
