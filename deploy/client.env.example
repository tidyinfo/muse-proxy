# Copy to /etc/muse-proxy/fwd.env (mode 600) on the client host.
# Never commit the real file.
#
# FWD_URL is required. Two ways to carry the secret:
#
#   1. In the path (default). nginx can switch access logging off for the
#      /fwd/ location without parsing headers, which is why this is the
#      default. It does mean the secret can land in an access log -- so
#      the bundled nginx snippet turns logging off there.
FWD_URL=wss://example.com/fwd/PASTE_SECRET_HERE
#
#   2. Out of band. Uncomment FWD_SECRET and leave it out of the URL, then
#      pass -secret-file. The secret then never appears in a URL, a log
#      line, or a Referer header.
#FWD_URL=wss://example.com/fwd/
#FWD_SECRET=PASTE_SECRET_HERE
