# Release image: consumes the binary goreleaser already built, so the image
# and the tarball are the same artifact of the same commit rather than two
# independent builds that could drift.
#
# For building from source instead (development, or a modified tree), use the
# inline form in the README's Container section.
ARG ARTIFACT
FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata \
 && adduser -D -u 10001 muse

COPY ${ARTIFACT} /usr/local/bin/muse-proxy-server

USER muse
WORKDIR /tmp

# Loopback only by default: binding anything wider is the operator's explicit
# decision, made in front of a reverse proxy. See docs/SECURITY.md.
EXPOSE 18080 2222
ENTRYPOINT ["/usr/local/bin/muse-proxy-server"]
CMD ["-http", "127.0.0.1:18080", "-tcp", "127.0.0.1:2222", "-target", "127.0.0.1:22"]
